{
  "name": "@reorg-safe/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Escrow contract with EIP-712 gasless release and pull-payment settlement (Hardhat 3 + Solidity tests)",
  "scripts": {
    "build": "hardhat build && node scripts/export-abi.mjs",
    "compile": "hardhat build",
    "export-abi": "node scripts/export-abi.mjs",
    "test": "hardhat test",
    "test:sol": "hardhat test solidity",
    "test:ts": "hardhat test nodejs",
    "node": "hardhat node",
    "deploy:local": "hardhat ignition deploy ignition/modules/Escrow.ts --network localhost",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^24.0.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.7",
    "hardhat": "^3.21.1",
    "typescript": "~5.9.0",
    "viem": "^2.57.12"
  }
}
