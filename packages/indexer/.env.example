# Comma-separated JSON-RPC endpoints. Two or more enables failover and hash-quorum reorg confirmation.
RPC_URLS=http://127.0.0.1:8545,http://127.0.0.1:8546

# Escrow contract address and its deployment block.
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
START_BLOCK=0

# Finality depth. Reorgs deeper than this are treated as a fatal integrity failure.
# 12 is a reasonable pre-merge-style default; use 2-6 on a local devnet, 64+ for finality-tag parity on mainnet.
CONFIRMATIONS=6

BLOCK_BATCH=50
POLL_INTERVAL_MS=1000
REQUEST_TIMEOUT_MS=8000
QUORUM=2
LAG_TOLERANCE=2
FAILURE_THRESHOLD=3

DB_PATH=./data/indexer.sqlite
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
LOG_FORMAT=pretty
