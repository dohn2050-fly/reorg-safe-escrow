{
  "name": "@reorg-safe/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reorg-safe EVM event indexer with multi-provider failover, hash-quorum reorg confirmation and atomic per-block commits",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@reorg-safe/shared": "*",
    "fastify": "^5.12.7",
    "viem": "^2.57.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^5.0.5"
  }
}
