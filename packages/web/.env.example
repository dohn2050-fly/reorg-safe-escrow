# Address of the deployed Escrow contract (printed by `npm run deploy:local` or the chaos runner).
VITE_ESCROW_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Indexer API base URL.
VITE_INDEXER_URL=http://127.0.0.1:4000
# RPC used by the browser for reads/writes on the local devnet (chainId 31337).
VITE_RPC_URL=http://127.0.0.1:8545
# Optional: enables the WalletConnect connector when set.
VITE_WALLETCONNECT_PROJECT_ID=
